# Complete only after reviewing production.review.json. These are not deployable image references.
RELEASE_TAG=REVIEW_REQUIRED
IMAGE_PREFIX=report-designer
WEB_IMAGE=REVIEW_REQUIRED
DOTNET_IMAGE=REVIEW_REQUIRED
NESTJS_IMAGE=REVIEW_REQUIRED
GATEWAY_IMAGE=REVIEW_REQUIRED
PUBLIC_HOST=REVIEW_REQUIRED
PRODUCTION_BIND=127.0.0.1
HTTPS_PORT=443
REDIRECT_PORT=80
# Start on authenticated NestJS; the later .NET cutover is an explicit web-only change.
API_UPSTREAM=api-nestjs:3000
MAINTENANCE_MODE=1
DB_HOST=REVIEW_REQUIRED
DB_PORT=5432
DB_NAME=REVIEW_REQUIRED
DB_USERNAME=REVIEW_REQUIRED
SECRETS_DIR=./secrets
TLS_CERT_FILE=./secrets/https-fullchain.pem
TLS_KEY_FILE=./secrets/https-private.key
