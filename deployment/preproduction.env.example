# Independent preproduction environment; no production database, credentials or listeners.
RELEASE_TAG=replace-with-reviewed-git-sha
IMAGE_PREFIX=report-designer-preproduction
PUBLIC_HOST=preproduction.reports.example.com
API_UPSTREAM=api-dotnet:8080
PREPRODUCTION_BIND=127.0.0.1
HTTPS_PORT=8443
REDIRECT_PORT=8081
DB_HOST=preproduction-postgres.example.com
DB_PORT=5432
DB_NAME=report_designer_preproduction
DB_USERNAME=report_designer_preproduction_app
SECRETS_DIR=./preproduction-secrets
TLS_CERT_FILE=./preproduction-secrets/https-fullchain.pem
TLS_KEY_FILE=./preproduction-secrets/https-private.key
