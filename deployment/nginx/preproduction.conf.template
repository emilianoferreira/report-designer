# Docker DNS must be refreshed when web is recreated to select the other backend.
resolver 127.0.0.11 valid=2s ipv6=off;
resolver_timeout 3s;
map $request_method $release_mutation {
    default 1;
    GET 0;
    HEAD 0;
    OPTIONS 0;
}
map "${MAINTENANCE_MODE}:$release_mutation" $release_write_blocked {
    default 1;
    "0:0" 0;
    "0:1" 0;
    "1:0" 0;
}
map $release_write_blocked $release_cache_control { default ""; 1 "no-store"; }
map $release_write_blocked $release_retry_after { default ""; 1 "30"; }
upstream preproduction_web {
    zone preproduction_web 64k;
    server web:8080 resolve;
    keepalive 16;
}

server {
    listen 8080;
    server_name ${PUBLIC_HOST};
    server_tokens off;
    location = /health/live {
        access_log off;
        return 200 "Healthy\n";
    }
    # Do not forward credentials or replay writes received over cleartext HTTP.
    location /api {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 426 '{"statusCode":426,"message":"HTTPS required"}';
    }
    location / {
        return 308 https://${PUBLIC_HOST}:${HTTPS_PORT}$request_uri;
    }
}

server {
    listen 8443 ssl;
    server_name ${PUBLIC_HOST};
    server_tokens off;
    ssl_certificate /run/secrets/https-fullchain.pem;
    ssl_certificate_key /run/secrets/https-private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    client_max_body_size 32m;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Cache-Control $release_cache_control always;
    add_header Retry-After $release_retry_after always;
    location / {
        default_type application/json;
        if ($release_write_blocked) {
            return 503 '{"statusCode":503,"message":"Writes paused for controlled release"}';
        }
        proxy_pass http://preproduction_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_next_upstream off;
        proxy_intercept_errors off;
    }
}
