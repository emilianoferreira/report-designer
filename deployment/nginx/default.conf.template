upstream api_backend {
    server ${API_UPSTREAM};
    keepalive 16;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    # Angular can embed images in template_json. Keep this above both API parsers' limits.
    client_max_body_size 32m;
    add_header X-Content-Type-Options nosniff always;

    location = /health/live {
        access_log off;
        default_type text/plain;
        return 200 "Healthy\n";
    }
    # A read-only readiness check supported by both backends. Errors remain errors.
    location = /health/ready {
        proxy_pass http://api_backend/api/templates?companyId=00000000-0000-0000-0000-000000000000;
        proxy_set_header Host $host;
        proxy_next_upstream off;
        proxy_intercept_errors off;
    }
    location /api {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_next_upstream off;
        proxy_intercept_errors off;
    }
    location = /index.html {
        add_header Cache-Control "no-store" always;
    }
    location ~* "-[a-z0-9]{8,}\.(js|css)$" {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ~* \.(js|css|map|png|jpg|svg|ico|woff2?)$ {
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
