{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["playwright.stage0.config.ts", "playwright.stage8.config.ts", "playwright.stage9.config.ts", "stage0/**/*.ts", "stage8/**/*.ts", "stage9/**/*.ts"]
}
