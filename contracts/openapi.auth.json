  },
  "components": {
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "UUID. El servidor actual delega validación a PostgreSQL; mal formado produce 500."
      },
      "CompanyId": {
        "name": "companyId",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Opcional: debe coincidir con la empresa activa de la sesión; de lo contrario 403. Si se omite, se usa la empresa activa."
