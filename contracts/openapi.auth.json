              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "rd_session; HttpOnly; SameSite=Strict; Secure en producción; Path=/; Max-Age=28800"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "statusCode",
                    "message",
                    "error"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "statusCode": {
                      "const": 401
                    },
                    "message": {
                      "const": "Unauthorized"
                    },
                    "error": {
                      "const": "Unauthorized"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "statusCode",
                    "message",
                    "error"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "statusCode": {
                      "const": 403
                    },
                    "message": {
                      "const": "Forbidden"
                    },
                    "error": {
                      "const": "Forbidden"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Máximo 10 intentos por correo o 100 por conexión del proxy en 15 minutos."
          }
        }
      }
    },
