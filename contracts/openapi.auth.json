            "schema": {
              "$ref": "#/components/schemas/NotFoundError"
            }
          }
        }
      },
      "DatabaseError": {
        "description": "Error existente de base de datos, sin detalle SQL público",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ServerError"
            }
          }
        }
      }
    },
